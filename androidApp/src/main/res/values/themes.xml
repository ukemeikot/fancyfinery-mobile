<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose does all the real theming. This exists only to set the window
      background that shows BEFORE the first frame is drawn.

      It is Obsidian, not white: the app opens on the dark splash sequence, and
      a white window behind it produces a bright flash on every cold start.
    -->
    <style name="Theme.FancyFinery" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_obsidian</item>
        <item name="android:navigationBarColor">@color/brand_obsidian</item>
        <item name="android:statusBarColor">@color/brand_obsidian</item>
    </style>
</resources>
